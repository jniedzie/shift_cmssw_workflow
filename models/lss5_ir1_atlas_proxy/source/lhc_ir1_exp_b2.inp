* ---------------------------------------------------------------------------- *
* 'regn' file for BASIC_ELEMENT: 'lhc_MCSTX_BD'                                *
* ---------------------------------------------------------------------------- *
*                                                                              *
* 
*
* -*- fluka -*-
*
* Element: MCSTX: nested multiple coils in the Inner Triple Q3 corrector
* Prototype to be used in a assembly
*
* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
* @@@
* @@@   FLUKA model of MCSTX, 12/01/2012
* @@@   L.S. Esposito, based on drawing LHCMCSTC001* and references therein
* @@@
* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*
* Shrinking cylinder
* drawning LHCMCSTC003
* material is Al Mg Si 1. Since it is mostly Aluminum, set it to ALUMINUM
MCSTXshc     5 +MCSTX_BD -MCSXext
* external epoxy band of MCSX sextupole coil
MCSXepe      5 +MCSTX_BD +MCSXext -MCSXcoin
* external insulator layer on MCSX bobine
* Epoxy?
MCSXin       5 +MCSTX_BD +MCSXcoin -MCSXco
* Central post
* Material: epoxy
* Drawning LHCMCSX_0002
MCSXep       5 +MCSTX_BD +MCSXco -MCSXci -MCSXpl1 -MCSXpl6
               | +MCSTX_BD +MCSXco +MCSXpl2 -MCSXci -MCSXpl3
               | +MCSTX_BD +MCSXco +MCSXpl4 -MCSXci -MCSXpl5
               | +MCSTX_BD +MCSXco +MCSXpl1 +MCSXpl6 -MCSXci
               | +MCSTX_BD +MCSXco +MCSXpl3 -MCSXci -MCSXpl2
               | +MCSTX_BD +MCSXco +MCSXpl5 -MCSXci -MCSXpl4
* coil assembly - sextupole
* drawning LHCMCSX_0001
MCSXcoil     5 +MCSTX_BD +MCSXco -MCSXci +MCSXpl1 -MCSXpl2
               | +MCSTX_BD +MCSXco +MCSXpl3 -MCSXci -MCSXpl4
               | +MCSTX_BD +MCSXco +MCSXpl5 -MCSXci -MCSXpl6
               | +MCSTX_BD +MCSXco +MCSXpl2 -MCSXci -MCSXpl1
               | +MCSTX_BD +MCSXco +MCSXpl4 -MCSXci -MCSXpl3
               | +MCSTX_BD +MCSXco +MCSXpl6 -MCSXci -MCSXpl5
* internal epoxy band of MCSX sextupole coil
MCSXepi      5 +MCSTX_BD +MCSXci -MCTXco
* Coil dodecapole MCTX
MCTXcoil     5 +MCSTX_BD +MCTXco -MCTXci +MCSTXpyz +MCTX_p1 -MCTX_p2
               | +MCSTX_BD +MCTXco -MCTXci +MCSTXpyz +MCTX_p3 -MCTX_p4
               | +MCSTX_BD +MCTXco +MCTX_p6 -MCTXci -MCSTXpxz -MCTX_p5
               | +MCSTX_BD +MCTXco -MCTXci -MCSTXpyz +MCTX_p7 -MCTX_p8
               | +MCSTX_BD +MCTXco +MCTX_p9 -MCTXci -MCSTXpyz -MCTX_p10
               | +MCSTX_BD +MCTXco -MCTXci +MCTX_p11 -MCTX_p12
               | +MCSTX_BD +MCTXco -MCTXci -MCSTXpyz +MCTX_p13 -MCTX_p14
               | +MCSTX_BD +MCTXco -MCTXci -MCSTXpyz +MCTX_p15 -MCTX_p16
               | +MCSTX_BD +MCTXco -MCTXci +MCSTXpyz +MCTX_p17 -MCTX_p18
               | +MCSTX_BD +MCTXco +MCSTXpxz +MCTX_p19 -MCTXci -MCTX_p20
               | +MCSTX_BD +MCTXco +MCSTXpxz +MCTX_p6 -MCTXci -MCTX_p5
* MCTX copper plate
* Drawning LHCMCTX_0003
MCTXpl       5 +MCSTX_BD +MCTXco -MCTXci +MCSTXpyz -MCTX_p1 -MCTX_p11
               | +MCSTX_BD +MCTXco -MCTXci +MCSTXpyz +MCTX_p2 -MCTX_p3
               | +MCSTX_BD +MCTXco -MCTXci -MCSTXpxz +MCTX_p4 +MCTX_p5
               | +MCSTX_BD +MCTXco -MCTXci -MCSTXpxz -MCTX_p6 -MCTX_p7
               | +MCSTX_BD +MCTXco -MCTXci -MCSTXpyz +MCTX_p8 -MCTX_p9
               | +MCSTX_BD +MCTXco -MCTXci -MCSTXpyz +MCTX_p10 -MCTX_p11
               | +MCSTX_BD +MCTXco -MCTXci -MCSTXpyz +MCTX_p12 -MCTX_p13
               | +MCSTX_BD +MCTXco -MCTXci -MCSTXpyz +MCTX_p14 -MCTX_p15
               | +MCSTX_BD +MCTXco -MCTXci +MCSTXpxz +MCTX_p16 -MCTX_p6
               | +MCSTX_BD +MCTXco -MCTXci +MCSTXpxz +MCTX_p5 -MCTX_p17
               | +MCSTX_BD +MCTXco -MCTXci +MCSTXpxz +MCTX_p18 -MCTX_p19
               | +MCSTX_BD +MCTXco -MCTXci +MCSTXpyz +MCTX_p12 +MCTX_p20
* Tube for dodecapole
* Drawning LHCMCSTX0004
MCSTXep      5 +MCSTX_BD +MCTXci -MCSTXvac
MCSTXvac     5 +MCSTX_BD +MCSTXvac
