*
*
* ### Air ###
TASair     5 | +TAS_BODY -TASvflc1 +TAScabp1
             | +TAS_BODY -TASvchc1 +TASvchp2 -TAScabp2
             | +TAS_BODY -TASvflc4 -TASvchp2 +TASvflp1
             | +TAS_BODY -TASvflc2 -TASvflp1
*
* ### Vacuum chamber sub-assembly (incl. flanges) ###
TASvac     5 | +TAS_BODY +TASvchc2
             | +TASvflc5 -TASvchp2 +TASvflp1
             | +TAS_BODY +TASvflc3 -TASvflp1
TASvch     5 | +TAS_BODY +TASvchc1 -TASvchc2 -TAScabp1 +TASvchp2
TASvfl1    5 | +TAS_BODY +TASvflc1 +TAScabp1 -TASvchc2
TASvfl2    5 | +TAS_BODY +TASvflc2 -TASvflc3 -TASvflp1
TASvfl2a   5 | +TAS_BODY +TASvflc4 -TASvflc5 -TASvchp2 +TASvflp1
*
* ### TAS Copper absorber ###
TAScabs    5 | +TAS_BODY -TASvchc1 -TAScabp1 +TAScabp2
