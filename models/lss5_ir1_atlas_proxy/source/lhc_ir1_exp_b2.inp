* @@@   FLUKA model of Neutral Particle Absorber (TAN), 18/10/2011
* @@@   based on previous model by M Fuerstner with 
* @@@   several revisions by A. Lechner
* @@@
* @@@   Defines: * Use '#define no_ZDC' to use copper bars and
* @@@              not ZDC as insert
* @@@            * Use '#define __TAN_ABSORBER_BLCKHOLE__' to set
* @@@              absorbers, marble to blackhole
* @@@
* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*
* ### Air ###
ASSIGNMA         AIR    TANair
*
* ### Beam pipes ###
ASSIGNMA      COPPER    TANbp1
ASSIGNMA      COPPER   TANbp2a
ASSIGNMA      COPPER   TANbp2b
*
* ### Vacuum in beam pipes ###
ASSIGNMA      VACUUM   TANbp1v
ASSIGNMA      VACUUM  TANbp2av
ASSIGNMA      VACUUM  TANbp2bv
*
* ### Marble ###
#if __TAN_ABSORBER_BLCKHOLE__
ASSIGNMA    BLCKHOLE  TANmarbl
#else
MATERIAL                            2.75                              TANMRBL
COMPOUND         1.0   CALCIUM       1.0    CARBON       3.0    OXYGENTANMRBL
ASSIGNMA     TANMRBL  TANmarbl
#endif
*
* ### Outer assembly bottom ###
ASSIGNMA      SS304L   TANoabt
*
* ### Outer assembly ###
#if __TAN_ABSORBER_BLCKHOLE__
ASSIGNMA    BLCKHOLE     TANoa
#else
ASSIGNMA      SS304L     TANoa
#endif
*
* ### Inner assembly absorber box ###
#if __TAN_ABSORBER_BLCKHOLE__
ASSIGNMA    BLCKHOLE  TANiaabs
#else   
ASSIGNMA      SS304L  TANiaabs
#endif
*
* ### Inner assembly copper ###
ASSIGNMA    COPPERSS   TANiacu
*
* ### Inserts: air gaps ###
ASSIGNMA         AIR   TANslta
*
* ### Inserts:BRAN ###
ASSIGNMA      SS304L  TANBRANb
ASSIGNMA      SS304L  TANBRANt
ASSIGNMA      COPPER  TANBRANc
ASSIGNMA         AIR  TANBRANi
*
* ### Inserts: bars ###
#if no_ZDC
*
ASSIGNMA    COPPERSS   TANbar1   TANbar9
ASSIGNMA         AIR   TANbara    
*
* ### Inserts: ZDC ###
#else
*
* (EM section)
ASSIGNMA      COPPER  TANZDCeb 
ASSIGNMA    TUNGSTEN  TANZDCet 
ASSIGNMA         AIR  TANZDCea 
*
* (Had section)
ASSIGNMA      COPPER  TANZDChb 
ASSIGNMA         AIR  TANZDCha 
ASSIGNMA         AIR  TANZDChi
*
ASSIGNMA      QUARTZ  TANZDht1  TANZDht4
ASSIGNMA        LEAD  TANZpb01  TANZpb10       2.0  
* (borated polyethylene for TAN luminosity detector)
MATERIAL                            0.99                              TANbPE
COMPOUND      -0.137  HYDROGEN    -0.039     BORON    -0.824    CARBONTANbPE
ASSIGNMA      TANbPE  TANZpe01  TANZpe10       2.0  
*
ASSIGNMA      QUARTZ   TANZgQu
ASSIGNMA    TUNGSTEN  TANZhTun
*
#endif
*
* 
