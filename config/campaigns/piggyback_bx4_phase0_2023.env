#!/usr/bin/env bash

# Paired comparison to the BX0/phase0 piggyback campaign.
# The central recorded collision remains BX0. The complete physical SHIFT
# event is delayed by 4 * 25 ns = 100 ns. Detector and trigger settings are
# unchanged.
export CAMPAIGN_NAME="Charmonium_FixedTarget_pThat_1to5GeV_13p6TeV_piggybackCentral_bx4_phase0_2023_v1"
export N_EVENTS=10
export N_JOBS=1000
export COLLISION_YEAR=2023

# Matching chunk numbers use the same generated event, Geant4 random stream,
# pileup event sequence, and recorded-trigger draw as the BX0 campaign.
export GENERATOR_SEED=13579
export SIMULATION_SEED=24680
export PILEUP_MODE=standard
export PILEUP_SEED=86420
export PILEUP_SEQUENTIAL=1
export TRIGGER_TIMELINE_SEED=24680

export TRIGGER_SCENARIO=piggyback_central
export TRIGGER_TIMELINE_MODE=zero_bias_proxy
export TRIGGER_TIMELINE_START_BX=0
export TRIGGER_TIMELINE_END_BX=0
export TRIGGER_RULE_MODE=recorded
export PIGGYBACK_FILTER_RECONSTRUCTION=1
export PIGGYBACK_FILTER_LEVEL=persisted

export SHIFT_TIMING_MODE=nominal
export SHIFT_TIMING_BX_OFFSET=4
export SHIFT_TIMING_PHASE_NS=0.0
export SHIFT_READOUT_DIAGNOSTICS=0
