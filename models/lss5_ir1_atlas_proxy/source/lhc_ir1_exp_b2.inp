               |  +MBRCBODY -d2pzu +d2pzd -d2_cri +d2_cro +pD20 -pD2r2
D2_CRL       5 |  +MBRCBODY -d2pzu +d2pzd -d2_cri +d2_cro +pD20 -pD2r1
               |  +MBRCBODY -d2pzu +d2pzd -d2_cri +d2_cro -pD20 +pD2r2
D2_PL_XX     5 +MBRCBODY -d2pzu +d2pzd -d2_xli +d2_cli
D2_PR_XX     5 +MBRCBODY -d2pzu +d2pzd -d2_xri +d2_cri
D2_PL_HE     5 +MBRCBODY -d2pzu +d2pzd -d2_il +d2_xli
