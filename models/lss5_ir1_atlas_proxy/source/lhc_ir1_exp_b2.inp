               | +MCBXp2 -MCBXp1 +MCBXoce +MCBXplyz +MCBXpo19 -MCBXoci -MCBXpo20
               | +MCBXp2 -MCBXp1 +MCBXoce +MCBXplyz +MCBXpo7 -MCBXoci -MCBXpo8
               | +MCBXp2 -MCBXp1 +MCBXoce +MCBXplyz +MCBXpo21 -MCBXoci -MCBXpo22
               | +MCBXp2 -MCBXp1 +MCBXoce +MCBXplyz +MCBXpo23 -MCBXoci -MCBXpo24
               | +MCBXp2 -MCBXp1 +MCBXoce +MCBXplyz +MCBXpo25 -MCBXoci -MCBXpo26
