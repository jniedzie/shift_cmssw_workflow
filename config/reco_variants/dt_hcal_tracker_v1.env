export SHIFT_RECO_VARIANT=dt_hcal_tracker_v1
export SHIFT_RECO_VARIANT_CODE=17

# Reuse the ordinary Phase-I DIGI stream. ZDC is not a usable simulated
# constraint in this campaign and must not force a dedicated Step-2 identity.
export SHIFT_STEP2_VARIANT=
export SHIFT_ZDC_DIGI_TIME_PHASE_OFFSET_NS=0.0

# Keep the validated DT augmentation. Tracker rechit augmentation stays
# guarded and is an exact no-op unless a detector-only ShiftMuon actually
# enters the tracker envelope and finds covariance-compatible measurements.
export SHIFT_DT_MODE=standard
export SHIFT_TRACKER_MODE=none
export SHIFT_ENABLE_GEM=0
export SHIFT_AUGMENT_DT_HITS=1
export SHIFT_AUGMENT_TRACKER_HITS=1

# Retain HBHE/HO spatial and timing diagnostics. ECAL/HF are no longer active
# matching inputs, and ZDC/BRIL remain outside this reconstruction iteration.
export SHIFT_ENABLE_HCAL_DIAGNOSTICS=1
export SHIFT_ENABLE_ZDC_DIAGNOSTICS=0
export SHIFT_USE_EXTENDED_TIMING=1
