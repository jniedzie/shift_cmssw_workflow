D2_VACO      5 +MBRCBODY -d2pzu +d2pzd -d2_oyoke
D2_YOKE      5 +MBRCBODY -d2pzu +d2pzd -d2_yl -d2_yr +d2_oyoke
D2_COLL      5 |  +MBRCBODY -d2pzu +d2pzd -d2_cli +d2_clo -pD20 -pD2l1 -pD2l2
               |  +MBRCBODY -d2pzu +d2pzd -d2_cli +d2_clo +pD20 +pD2l1 +pD2l2
               |  +MBRCBODY -d2pzu +d2pzd -d2_clo +d2_yl
D2_COLR      5 |  +MBRCBODY -d2pzu +d2pzd -d2_cri +d2_cro -pD20 -pD2r1 -pD2r2
               |  +MBRCBODY -d2pzu +d2pzd -d2_cri +d2_cro +pD20 +pD2r1 +pD2r2
               |  +MBRCBODY -d2pzu +d2pzd -d2_cro +d2_yr
