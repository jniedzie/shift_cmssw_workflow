export SHIFT_RECO_VARIANT=detector_integration_v2
export SHIFT_RECO_VARIANT_CODE=15
export SHIFT_STEP2_VARIANT=early_zdc
# Move the source-side ZDC pulse by about 0.93 microseconds into the ordinary
# ten-sample readout frame. The physical offset is retained in the variant
# metadata and must be restored when interpreting the reconstructed time.
export SHIFT_ZDC_DIGI_TIME_PHASE_OFFSET_NS=-930.0
export SHIFT_DT_MODE=standard
export SHIFT_TRACKER_MODE=none
export SHIFT_ENABLE_GEM=1
export SHIFT_ENABLE_HCAL_DIAGNOSTICS=1
export SHIFT_ENABLE_ZDC_DIAGNOSTICS=1
export SHIFT_AUGMENT_DT_HITS=1
export SHIFT_AUGMENT_TRACKER_HITS=1
export SHIFT_USE_EXTENDED_TIMING=1
