D2_PL_I      5 +MBRCBODY +d2_pli +d2pzd -d2BS_lo -d2pzu
               | +MBRCBODY +d2BS_lo +d2pzd -d2pBSaw -d2pzu
               | +MBRCBODY +d2BS_lo +d2pBSbw +d2pzd -d2pzu
D2_PR_I      5 +MBRCBODY +d2_pri +d2pzd -d2BS_ro -d2pzu
