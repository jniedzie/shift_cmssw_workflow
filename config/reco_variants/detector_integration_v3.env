export SHIFT_RECO_VARIANT=detector_integration_v3
export SHIFT_RECO_VARIANT_CODE=16

# The v2 early-ZDC files were produced before the Phase-I ZDC digitizer was
# explicitly enabled. Use a new Step-2 identity so valid-but-empty v2 files
# can never be reused by this campaign.
export SHIFT_STEP2_VARIANT=early_zdc_v2
export SHIFT_ZDC_DIGI_TIME_PHASE_OFFSET_NS=-930.0

export SHIFT_DT_MODE=standard
export SHIFT_TRACKER_MODE=none
export SHIFT_ENABLE_GEM=1
export SHIFT_ENABLE_HCAL_DIAGNOSTICS=1
export SHIFT_ENABLE_ZDC_DIAGNOSTICS=1

# Add independently compatible DT segments and tracker rechits only after the
# detector-only ShiftMuon exists. The precision refit remains an exact no-op
# when no extra measurement is accepted.
export SHIFT_AUGMENT_DT_HITS=1
export SHIFT_AUGMENT_TRACKER_HITS=1
export SHIFT_USE_EXTENDED_TIMING=1
