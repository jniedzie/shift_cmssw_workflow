D2BVACO      5 +MBRCBODY -d2pzd -d2_oyoke
D2BYOKE      5 +MBRCBODY -d2pzd -d2_yl -d2_yr +d2_oyoke
D2BCOLL      5 |  +MBRCBODY -d2pzd -d2_cli +d2_clo -pD20 -pD2l1 -pD2l2
               |  +MBRCBODY -d2pzd -d2_cli +d2_clo +pD20 +pD2l1 +pD2l2
