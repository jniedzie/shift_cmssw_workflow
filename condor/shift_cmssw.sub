universe              = vanilla
executable            = <workflow_root>/scripts/run_condor_job.sh
should_transfer_files = NO
getenv                = True
request_cpus          = <request_cpus>
request_memory        = <request_memory_mb> MB
max_materialize       = <max_materialize>
CHUNK                 = $(Process)
arguments             = "$(CHUNK) '<workflow_root>' '<selected_steps>' '<force_selected>'"
output                = <log_dir>/condor_$(ClusterId).$(Process).out
error                 = <log_dir>/condor_$(ClusterId).$(Process).err
log                   = <log_dir>/condor_$(ClusterId).log
queue <n_jobs>
