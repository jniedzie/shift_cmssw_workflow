# Source with set -a in a fresh shell.  This prepares one exclusive bin from
# the common SoftQCD/MPI phase space and never submits by itself.
MPI_PARTITION_SAMPLE=${MPI_PARTITION_SAMPLE:-qcd}
MPI_PARTITION_BIN=${MPI_PARTITION_BIN:-0to1}
case "$MPI_PARTITION_BIN" in
  0to1) GEN_PTHAT_MIN=0; GEN_PTHAT_MAX=1; seed_offset=0 ;;
  1to2) GEN_PTHAT_MIN=1; GEN_PTHAT_MAX=2; seed_offset=100000 ;;
  2to5) GEN_PTHAT_MIN=2; GEN_PTHAT_MAX=5; seed_offset=200000 ;;
  5to10) GEN_PTHAT_MIN=5; GEN_PTHAT_MAX=10; seed_offset=300000 ;;
  10to20) GEN_PTHAT_MIN=10; GEN_PTHAT_MAX=20; seed_offset=400000 ;;
  20to-1) GEN_PTHAT_MIN=20; GEN_PTHAT_MAX=-1; seed_offset=500000 ;;
  *) echo "Unsupported MPI_PARTITION_BIN: $MPI_PARTITION_BIN" >&2; return 2 ;;
esac
case "$MPI_PARTITION_SAMPLE" in
  qcd)
    SAMPLE_NAME=qcd
    PROCESS=QCD_SoftMpiPartition_FixedTarget_13p6TeV
    GEN_EVENT_CLASS=qcd
    sample_seed_offset=0
    ;;
  jpsi)
    SAMPLE_NAME=jpsi
    PROCESS=Charmonium_SoftMpiPartition_FixedTarget_13p6TeV
    GEN_EVENT_CLASS=direct_jpsi
    sample_seed_offset=10000000
    ;;
  *) echo "MPI_PARTITION_SAMPLE must be qcd or jpsi" >&2; return 2 ;;
esac
CAMPAIGN_NAME=${CAMPAIGN_NAME:-${SAMPLE_NAME}_SoftMpiPartition_pThat_${MPI_PARTITION_BIN}_ATLASproxy_2023_v1}
N_EVENTS=${N_EVENTS:-20}
N_JOBS=${N_JOBS:-1}
GENERATOR_SEED=${GENERATOR_SEED:-$((81000000+sample_seed_offset+seed_offset))}
SIMULATION_SEED=${SIMULATION_SEED:-$((91000000+sample_seed_offset+seed_offset))}
unset sample_seed_offset seed_offset
WORKFLOW_LOCAL_GENERATOR=1
CMSSW_PREPARED=${CMSSW_PREPARED:-1}
CLEANUP_PREVIOUS_STEP=${CLEANUP_PREVIOUS_STEP:-1}
CONDOR_REQUEST_CPUS=1
CONDOR_REQUEST_MEMORY_MB=4000
CONDOR_REQUEST_DISK_MB=10000
CONDOR_MAX_RUNTIME_SECONDS=50400
CONDOR_JOB_FLAVOUR=""
COLLISION_YEAR=2023
PILEUP_MODE=none
TRIGGER_SCENARIO=none
TRIGGER_TIMELINE_MODE=none
PIGGYBACK_FILTER_RECONSTRUCTION=0
ENABLE_EXONANOAOD=0
STEP4_INPUTS_PER_JOB=1
SHIFT_TIMING_MODE=nominal
SHIFT_TIMING_BX_OFFSET=0
SHIFT_TIMING_PHASE_NS=0.0
SHIFT_LSS_MATERIAL_MODE=external
SHIFT_LSS_FIELD_MODE=ir1_atlas_proxy
SHIFT_LSS_GDML_FILE=PhysicsTools/ShiftLssGeometry/data/ir1_atlas_proxy/lhc_ir1_halfspace_repaired_20260910.gdml
SHIFT_LSS_GDML_SHA256=d6f9f6fa5658a55e365d5a80025522cac7bcab1ce6fb006ca27b5120f5f41f66
SHIFT_LSS_ARTIFACT_ORIGIN_IN_MODEL_CM=0.0,4299.5,14575.200000105498
SHIFT_LSS_MODEL_ORIGIN_CM=0,0,0
SHIFT_LSS_MODEL_TO_CMS=1,0,0,0,1,0,0,0,1
SHIFT_LSS_MINIMUM_ABS_Z_CM=1100
SHIFT_LSS_MATERIAL_BOUNDARY_ABS_Z_CM=14800
SHIFT_LSS_GEANT4E_MAXIMUM_STEP_LENGTH_MM=0.2
SHIFT_LSS_GEANT4E_MAXIMUM_PATH_LENGTH_CM=20000
SHIFT_LSS_FIELD_SCALE=1.0
SHIFT_USE_VERTEX_CONSTRAINED_REFIT=1
SHIFT_USE_MATERIAL_AWARE_VERTEX_TRANSPORT=0
