# Source with set -a in a fresh shell; shared transport/resources match QCD.
JPSI_BIN=${JPSI_BIN:-1to2}
case "$JPSI_BIN" in
  1to2) jpsi_seed_offset=0 ;;
  2to5) jpsi_seed_offset=100000 ;;
  5to10) jpsi_seed_offset=200000 ;;
  *) echo "JPSI_BIN must be 1to2, 2to5 or 5to10 for this runtime-validated profile" >&2; return 2 ;;
esac
CAMPAIGN_NAME=${CAMPAIGN_NAME:-Jpsi_Unfiltered_pThat_${JPSI_BIN}_ATLASproxy_2023_v1}
GENERATOR_SEED=${GENERATOR_SEED:-$((61000000+jpsi_seed_offset))}
SIMULATION_SEED=${SIMULATION_SEED:-$((71000000+jpsi_seed_offset))}
unset jpsi_seed_offset
QCD_BIN=$JPSI_BIN
source "$(dirname "${BASH_SOURCE[0]}")/qcd_unfiltered_2023.env"
SAMPLE_NAME=jpsi
PROCESS=Charmonium_Unfiltered_FixedTarget_pThat_1to5GeV_13p6TeV
