universe              = vanilla
executable            = <workflow_root>/scripts/run_condor_job.sh
should_transfer_files = NO
getenv                = True
environment           = "COLLISION_YEAR=$ENV(COLLISION_YEAR) GEOMETRY=$ENV(GEOMETRY) ERA=$ENV(ERA) CONDITIONS=$ENV(CONDITIONS) BEAMSPOT=$ENV(BEAMSPOT) PILEUP_MODE=$ENV(PILEUP_MODE) PILEUP_SCENARIO=$ENV(PILEUP_SCENARIO) PILEUP_DATASET=$ENV(PILEUP_DATASET) PILEUP_INPUT=$ENV(PILEUP_INPUT) PILEUP_SEED=$ENV(PILEUP_SEED) SHIFT_TIMING_MODE=$ENV(SHIFT_TIMING_MODE) SHIFT_TIMING_BEAM_DIRECTION_Z=$ENV(SHIFT_TIMING_BEAM_DIRECTION_Z) SHIFT_TIMING_BX_OFFSET=$ENV(SHIFT_TIMING_BX_OFFSET) SHIFT_TIMING_PHASE_NS=$ENV(SHIFT_TIMING_PHASE_NS) SHIFT_TIMING_FIXED_OFFSET_NS=$ENV(SHIFT_TIMING_FIXED_OFFSET_NS) SHIFT_TIMING_CMS_REFERENCE_Z_MM=$ENV(SHIFT_TIMING_CMS_REFERENCE_Z_MM) SHIFT_TIMING_BUNCH_SPACING_NS=$ENV(SHIFT_TIMING_BUNCH_SPACING_NS) SHIFT_TIMING_LEGACY_OFFSET_CT_MM=$ENV(SHIFT_TIMING_LEGACY_OFFSET_CT_MM) SHIFT_TIMING_MODEL_VERSION=$ENV(SHIFT_TIMING_MODEL_VERSION) SHIFT_G4_MAX_TRACK_TIME_NS=$ENV(SHIFT_G4_MAX_TRACK_TIME_NS) SHIFT_G4_MAX_TRACK_TIME_FORWARD_NS=$ENV(SHIFT_G4_MAX_TRACK_TIME_FORWARD_NS) TRIGGER_TIMELINE_MODE=$ENV(TRIGGER_TIMELINE_MODE) TRIGGER_LIBRARY_JSONL=$ENV(TRIGGER_LIBRARY_JSONL) TRIGGER_L1_MENU_JSON=$ENV(TRIGGER_L1_MENU_JSON) TRIGGER_GROUP_ID=$ENV(TRIGGER_GROUP_ID) TRIGGER_TIMELINE_START_BX=$ENV(TRIGGER_TIMELINE_START_BX) TRIGGER_TIMELINE_END_BX=$ENV(TRIGGER_TIMELINE_END_BX) TRIGGER_TIMELINE_SEED=$ENV(TRIGGER_TIMELINE_SEED) TRIGGER_COLLIDING_BX_FILE=$ENV(TRIGGER_COLLIDING_BX_FILE) TRIGGER_TIMELINE_DIR=$ENV(TRIGGER_TIMELINE_DIR) SHIFT_DT_MODE=$ENV(SHIFT_DT_MODE) SHIFT_TRACKER_MODE=$ENV(SHIFT_TRACKER_MODE) SHIFT_ENABLE_GEM=$ENV(SHIFT_ENABLE_GEM) SHIFT_ENABLE_HCAL_DIAGNOSTICS=$ENV(SHIFT_ENABLE_HCAL_DIAGNOSTICS) SHIFT_ENABLE_ZDC_DIAGNOSTICS=$ENV(SHIFT_ENABLE_ZDC_DIAGNOSTICS) SHIFT_AUGMENT_DT_HITS=$ENV(SHIFT_AUGMENT_DT_HITS) SHIFT_AUGMENT_TRACKER_HITS=$ENV(SHIFT_AUGMENT_TRACKER_HITS) SHIFT_USE_EXTENDED_TIMING=$ENV(SHIFT_USE_EXTENDED_TIMING) SHIFT_REFIT_SECOND_SEED_ERROR_RESCALE=$ENV(SHIFT_REFIT_SECOND_SEED_ERROR_RESCALE) SHIFT_REFIT_USE_SECOND_ITERATION=$ENV(SHIFT_REFIT_USE_SECOND_ITERATION) SHIFT_REFIT_GEOMETRY_TARGET_MATERIAL=$ENV(SHIFT_REFIT_GEOMETRY_TARGET_MATERIAL) SHIFT_REFIT_SEED_MOMENTUM_SCALE=<seed_momentum_scale> SHIFT_REFIT_ENERGY_LOSS_SCALE=<energy_loss_scale> SHIFT_REFIT_DETAILED_MATERIAL_EFFECTS=<detailed_material_effects> SHIFT_REFIT_GEOMETRY_MATERIAL_EFFECTS=<geometry_material_effects> SHIFT_REFIT_GEOMETRY_MATERIAL_FITTER=<geometry_material_fitter> SHIFT_REFIT_GEOMETRY_MATERIAL_SMOOTHER=<geometry_material_smoother> SHIFT_REFIT_LOG_GEOMETRY_COMPARISON=<log_geometry_comparison> STEP4_INPUTS_PER_JOB=<step4_inputs_per_job> CMSSW_RUNTIME_FINGERPRINT=<cmssw_runtime_fingerprint>"
request_cpus          = <request_cpus>
request_memory        = <request_memory_mb> MB
max_materialize       = <max_materialize>
CHUNK                 = $(Process)
arguments             = "$(CHUNK) '<workflow_root>' '<selected_steps>' '<force_selected>' '<process>' '<sample_name>' '<campaign_name>' '<sample_base>' '<sample_dir>' '<n_events>'"
output                = <log_dir>/condor_$(ClusterId).$(Process).out
error                 = <log_dir>/condor_$(ClusterId).$(Process).err
log                   = <log_dir>/condor_$(ClusterId).log
queue <n_jobs>
