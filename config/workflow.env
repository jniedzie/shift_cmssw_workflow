# Select site-specific roots from the hostname. Explicit CMSSW_SRC and
# SAMPLE_BASE values in the caller's environment still take precedence.
# Query the current node instead of trusting HOSTNAME, which may be inherited
# from a Condor submission shell. WORKFLOW_HOST remains available as an
# explicit override for tests and unusual site configurations.
WORKFLOW_HOST="${WORKFLOW_HOST:-$(hostname -f 2>/dev/null || hostname)}"
case "$WORKFLOW_HOST" in
	*lxplus*)
		WORKFLOW_SITE="lxplus"
    DEFAULT_CMSSW_SRC="/afs/cern.ch/work/j/jniedzie/private/shift_cmssw/CMSSW_17_0_0_pre4/src"
		DEFAULT_SAMPLE_BASE="/eos/home-j/jniedzie/shift_cmssw"
		;;
	*iihe*|*t2b*)
		WORKFLOW_SITE="iihe"
		DEFAULT_CMSSW_SRC="/user/jniedzie/shift_cmssw/CMSSW_17_0_0_pre4/src"
		DEFAULT_SAMPLE_BASE="/pnfs/iihe/cms/store/user/jniedzie/shift_cmssw"
		;;
	*)
		if [[ -z "${CMSSW_SRC:-}" || -z "${SAMPLE_BASE:-}" ]]; then
			echo "ERROR [workflow.env]: unknown host '$WORKFLOW_HOST'; set CMSSW_SRC and SAMPLE_BASE explicitly" >&2
			return 1 2>/dev/null || exit 1
		fi
		WORKFLOW_SITE="custom"
		DEFAULT_CMSSW_SRC="$CMSSW_SRC"
		DEFAULT_SAMPLE_BASE="$SAMPLE_BASE"
		;;
esac
CMSSW_SRC="${CMSSW_SRC:-$DEFAULT_CMSSW_SRC}"
SAMPLE_BASE="${SAMPLE_BASE:-$DEFAULT_SAMPLE_BASE}"

SAMPLE_NAME="${SAMPLE_NAME:-jpsi}"

# PROCESS="Charmonium_pThat_50to100GeV_13p6TeV"
# PROCESS="Charmonium_FixedTarget_pThat_0to1GeV_13p6TeV"
PROCESS="${PROCESS:-Charmonium_FixedTarget_pThat_1to5GeV_13p6TeV}"

# CAMPAIGN_NAME="${PROCESS}_smallTest_beamB"
# CAMPAIGN_NAME="${CAMPAIGN_NAME:-${PROCESS}_timing_2023}"
# CAMPAIGN_NAME="${CAMPAIGN_NAME:-${PROCESS}_occupancy_2023}"
CAMPAIGN_NAME="${CAMPAIGN_NAME:-${PROCESS}_triggerProxy_2023}"

N_EVENTS="${N_EVENTS:-10}"
N_JOBS="${N_JOBS:-1000}"
# Step-4-only test acceleration. A value above one groups consecutive existing
# Step-3 chunks into each Step-4 job, amortizing PAT/NanoAOD and Geant4 startup.
# Keep one for ordinary production and for any submission that also runs an
# earlier workflow step.
STEP4_INPUTS_PER_JOB="${STEP4_INPUTS_PER_JOB:-1}"

# Campaign-wide collision-year preset. It changes the era, GlobalTag, pileup
# profile and central minimum-bias library as one unit. The 2023 library is the
# temporary default because it has active disk replicas, including at CERN.
# Explicit ERA/CONDITIONS/PILEUP_SCENARIO/PILEUP_DATASET values still override
# a preset, but do that only deliberately and record the combination.
COLLISION_YEAR="${COLLISION_YEAR:-2023}"
case "$COLLISION_YEAR" in
	2022)
		DEFAULT_ERA="Run3"
		DEFAULT_CONDITIONS="auto:phase1_2022_realistic"
		DEFAULT_BEAMSPOT="Realistic25ns13p6TeVEarly2022Collision"
		DEFAULT_PILEUP_SCENARIO="2022_25ns_RunIII2022Summer24_PoissonOOTPU"
		DEFAULT_PILEUP_DATASET="/MinBias_TuneCP5_13p6TeV-pythia8/Run3Summer22GS-124X_mcRun3_2022_realistic_v10-v1/GEN-SIM"
		;;
	2023)
		DEFAULT_ERA="Run3_2023"
		DEFAULT_CONDITIONS="auto:phase1_2023_realistic"
		DEFAULT_BEAMSPOT="Realistic25ns13p6TeVEarly2023Collision"
		DEFAULT_PILEUP_SCENARIO="2023_25ns_RunIII2023Summer24_PoissonOOTPU"
		DEFAULT_PILEUP_DATASET="/MinBias_TuneCP5_13p6TeV-pythia8/Run3Summer23GS-130X_mcRun3_2023_realistic_forMB_v1-v3/GEN-SIM"
		;;
	2024)
		DEFAULT_ERA="Run3_2024"
		DEFAULT_CONDITIONS="auto:phase1_2024_realistic"
		DEFAULT_BEAMSPOT="Realistic25ns13p6TeVEarly2023Collision"
		DEFAULT_PILEUP_SCENARIO="2024_25ns_RunIII2024Summer24_PoissonOOTPU"
		DEFAULT_PILEUP_DATASET="/MinBias_TuneCP5_13p6TeV-pythia8/RunIII2024Summer24GS-140X_mcRun3_2024_realistic_v20-v1/GEN-SIM"
		;;
	*)
		echo "ERROR [workflow.env]: COLLISION_YEAR must be 2022, 2023, or 2024 (got '$COLLISION_YEAR')" >&2
		return 1 2>/dev/null || exit 1
		;;
esac
DEFAULT_PILEUP_INPUT="filelist:$SAMPLE_BASE/pileup_inputs/pileup_files_run3_${COLLISION_YEAR}.txt"
DEFAULT_TRIGGER_LIBRARY_JSONL=""
DEFAULT_TRIGGER_L1_MENU_JSON=""
if [[ "$COLLISION_YEAR" == 2023 ]]; then
	DEFAULT_TRIGGER_LIBRARY_JSONL="$SAMPLE_BASE/trigger_inputs/2023/run369943/zero_bias_run369943.jsonl"
	DEFAULT_TRIGGER_L1_MENU_JSON="$SAMPLE_BASE/trigger_inputs/2023/run369943/zero_bias_l1_menu_run369943.json"
fi

# Every production stage must consume these exact values: changing geometry,
# era, or GlobalTag between simulation, reconstruction, and NanoAOD refitting
# makes track states and RecHit surfaces internally inconsistent.
GEOMETRY="${GEOMETRY:-DB:Extended}"
ERA="${ERA:-$DEFAULT_ERA}"
CONDITIONS="${CONDITIONS:-$DEFAULT_CONDITIONS}"
BEAMSPOT="${BEAMSPOT:-$DEFAULT_BEAMSPOT}"
HLT_MENU="${HLT_MENU:-@relval${COLLISION_YEAR}}"

# Condor resources and submission pressure.  Step 4 is deliberately
# single-threaded while the Geant4e momentum refit is enabled, so one CPU and
# 3 GB are sufficient for the observed roughly 2 GB process image.  Late
# materialization keeps only this many jobs in the schedd at once and
# replenishes them as jobs leave the queue.
CONDOR_REQUEST_CPUS="${CONDOR_REQUEST_CPUS:-1}"
CONDOR_REQUEST_MEMORY_MB="${CONDOR_REQUEST_MEMORY_MB:-3000}"
CONDOR_MAX_MATERIALIZE="${CONDOR_MAX_MATERIALIZE:-1000}"

# Generator seed used by Step 1. Set to "random" for a fresh seed on every
# invocation, or to a fixed integer from 1 through 900000000 for reproducible
# generation.
GENERATOR_SEED="${GENERATOR_SEED:-random}"
# Geant4 seed.  Fix both generator and simulation seeds when comparing timing
# points event by event; otherwise trajectories and PSimHit counts need not be
# paired even when the generated kinematics are identical.
SIMULATION_SEED="${SIMULATION_SEED:-random}"

# The three campaign-level study switches are intentionally independent:
#   SHIFT_TIMING_MODE=nominal       clean physical SHIFT event timing in Step 1
#   PILEUP_MODE=standard            standard central occupancy mixing in Step 2
#   TRIGGER_TIMELINE_MODE=zero_bias_proxy
#                                  empirical trigger candidates beside Step 2
# The trigger timeline is a versioned sidecar only; it does not yet alter the
# simulated electronics readout or apply trigger deadtime rules.

# Standard central CMS pileup is mixed in Step 2 from the collision-year
# preset's centrally produced GEN-SIM dataset. PILEUP_INPUT accepts the
# cmsDriver forms `das:...`,
# `filelist:/absolute/path`, or a comma-separated list of ROOT PFNs.  Production
# Condor campaigns should use a versioned file list prepared on the submit host
# so workers do not need a user proxy for DAS.
PILEUP_MODE="${PILEUP_MODE:-standard}"
PILEUP_SCENARIO="${PILEUP_SCENARIO:-$DEFAULT_PILEUP_SCENARIO}"
PILEUP_DATASET="${PILEUP_DATASET:-$DEFAULT_PILEUP_DATASET}"
PILEUP_INPUT="${PILEUP_INPUT:-$DEFAULT_PILEUP_INPUT}"
PILEUP_SEED="${PILEUP_SEED:-random}"
# Replica site used when preparing a production file list.  Keep this on disk;
# an unfiltered DBS/DAS inventory may include blocks with no readable replica.
PILEUP_RSE="${PILEUP_RSE:-T2_CH_CERN}"

# Empirical, correlated trigger-candidate timelines sampled from a validated
# ZeroBias library. One timeline is written per SHIFT event, over the requested
# relative BX range. Inputs must be durable absolute paths visible to workers.
TRIGGER_TIMELINE_MODE="${TRIGGER_TIMELINE_MODE:-zero_bias_proxy}"
TRIGGER_LIBRARY_JSONL="${TRIGGER_LIBRARY_JSONL:-$DEFAULT_TRIGGER_LIBRARY_JSONL}"
TRIGGER_L1_MENU_JSON="${TRIGGER_L1_MENU_JSON:-$DEFAULT_TRIGGER_L1_MENU_JSON}"
TRIGGER_GROUP_ID="${TRIGGER_GROUP_ID:-}"
TRIGGER_TIMELINE_START_BX="${TRIGGER_TIMELINE_START_BX:--24}"
TRIGGER_TIMELINE_END_BX="${TRIGGER_TIMELINE_END_BX:-5}"
TRIGGER_TIMELINE_SEED="${TRIGGER_TIMELINE_SEED:-random}"
TRIGGER_COLLIDING_BX_FILE="${TRIGGER_COLLIDING_BX_FILE:-}"
# `run3` applies the versioned L1A spacing-rule proxy after at least 240 BX of
# warm-up. Keep `none` as the pre-rule control until the selected run period is
# validated against recorded TCDS histories.
TRIGGER_RULE_MODE="${TRIGGER_RULE_MODE:-none}"
TRIGGER_RULE_HISTORY_START_BX="${TRIGGER_RULE_HISTORY_START_BX:--264}"

# SHIFT event timing is applied coherently after generation/standard vertex
# smearing and before Geant4.  The fragment owns spatial source generation;
# these settings own only the common event-time shift.
#
# Modes:
#   nominal: derive ct from the generated source z and beam direction;
#   legacy:  add the former Pythia Beams:offsetTime=-148000 mm/c;
#   fixed:   add SHIFT_TIMING_FIXED_OFFSET_NS for controlled timing tests.
# Integer BX and fractional phase are additive in every mode.
SHIFT_TIMING_MODE="${SHIFT_TIMING_MODE:-nominal}"
SHIFT_TIMING_BEAM_DIRECTION_Z="${SHIFT_TIMING_BEAM_DIRECTION_Z:--1}"
SHIFT_TIMING_BX_OFFSET="${SHIFT_TIMING_BX_OFFSET:-0}"
SHIFT_TIMING_PHASE_NS="${SHIFT_TIMING_PHASE_NS:-0.0}"
SHIFT_TIMING_FIXED_OFFSET_NS="${SHIFT_TIMING_FIXED_OFFSET_NS:-0.0}"
SHIFT_TIMING_CMS_REFERENCE_Z_MM="${SHIFT_TIMING_CMS_REFERENCE_Z_MM:-0.0}"
SHIFT_TIMING_BUNCH_SPACING_NS="${SHIFT_TIMING_BUNCH_SPACING_NS:-25.0}"
SHIFT_TIMING_LEGACY_OFFSET_CT_MM="${SHIFT_TIMING_LEGACY_OFFSET_CT_MM:--148000.0}"
SHIFT_TIMING_MODEL_VERSION="${SHIFT_TIMING_MODEL_VERSION:-fixed-target-v1}"

# The stock central Geant4 transport cutoff is 500 ns, approximately the
# light-flight time from the 148 m target to CMS.  Keep the transport guard
# wider than the full timing scan so detector digitization/readout, rather than
# this CPU-protection cutoff, determines signal acceptance.
SHIFT_G4_MAX_TRACK_TIME_NS="${SHIFT_G4_MAX_TRACK_TIME_NS:-5000.0}"
SHIFT_G4_MAX_TRACK_TIME_FORWARD_NS="${SHIFT_G4_MAX_TRACK_TIME_FORWARD_NS:-5000.0}"

# Print HepMC-to-GEANT4 primary conversion details for muons in Step 1.
# Set to 1 only for small diagnostic jobs; normal production should leave it at 0.
DEBUG_MUON_PRIMARIES="${DEBUG_MUON_PRIMARIES:-0}"

# Print each muon step in an active muon sensitive volume and each resulting
# PSimHit in Step 1. Enable only for small diagnostic jobs.
DEBUG_MUON_HITS="${DEBUG_MUON_HITS:-0}"

# Trace muon track start/end, geometry transitions, and CMSSW transport kills.
DEBUG_MUON_TRACKING="${DEBUG_MUON_TRACKING:-0}"

# Permit muons produced at either SHIFT target to travel through the existing
# CMStoZDC corridor toward CMS. The stepping rule requires a primary muon whose
# z momentum points opposite to the sign of its production vertex z.
SHIFT_TO_CMS_TRANSPORT="${SHIFT_TO_CMS_TRANSPORT:-1}"

# Controls whether CMSSW loads the release's prebuilt monolithic BigProducts
# simulation library ("biglib").
#
# Keep this at 0 while developing or testing local CMSSW source changes.  The
# workflow then loads package-level libraries, so `scram b <package>` is enough
# for the next run to use your changes; no full clean or BigProducts relink is
# needed.
#
# Set it to 1 only when you intentionally want the unmodified release biglib,
# for example for a reference/control run after removing or setting aside local
# simulation changes.  With 1, a targeted package build may be masked by the
# prebuilt biglib; local changes require rebuilding the corresponding
# BigProducts library (usually via a full `scram b`) before they take effect.
CMSSW_USE_BIGLIB="${CMSSW_USE_BIGLIB:-0}"

# Standard NanoAOD plus the focused SHIFT customisation is the production
# default.  Set this explicitly to 1 only for an EXONanoAOD comparison job.
ENABLE_EXONANOAOD="${ENABLE_EXONANOAOD:-0}"

# Optional CMSSW customization, in cmsDriver package/path.module.function form.
AOD_TO_EXONANO_CUSTOMISE="PhysicsTools/ShiftMuonSegments/shiftMuonSegments_customise.customise"

# Optional per-submission refit experiment. run_step4_exonanoAOD.sh writes
# this value explicitly into the generated CMSSW configuration, so concurrent
# Condor clusters can safely share one compiled release without reading a
# mutable test value from shiftMuonSegments_cfi.py.
SHIFT_REFIT_SEED_MOMENTUM_SCALE="${SHIFT_REFIT_SEED_MOMENTUM_SCALE:-1.0}"
SHIFT_REFIT_SECOND_SEED_ERROR_RESCALE="${SHIFT_REFIT_SECOND_SEED_ERROR_RESCALE:-100.0}"
SHIFT_REFIT_USE_SECOND_ITERATION="${SHIFT_REFIT_USE_SECOND_ITERATION:-0}"
SHIFT_REFIT_ENERGY_LOSS_SCALE="${SHIFT_REFIT_ENERGY_LOSS_SCALE:-1.0}"
# Use detailed Geant4e material transport inside the directional Kalman refit.
# This is an experimental, per-submission switch; 0 preserves the established
# SteppingHelix refit exactly.
SHIFT_REFIT_DETAILED_MATERIAL_EFFECTS="${SHIFT_REFIT_DETAILED_MATERIAL_EFFECTS:-0}"
# Sample the DD4hep/Geant4 material map for the mean Kalman energy loss while
# retaining SteppingHelix covariance transport. Mutually exclusive with the
# full detailed-material refit above.
SHIFT_REFIT_GEOMETRY_MATERIAL_EFFECTS="${SHIFT_REFIT_GEOMETRY_MATERIAL_EFFECTS:-0}"
# Split-pass geometry-material ablation. The umbrella switch above continues
# to enable both; these independently select only the forward filter or the
# backward smoother.
SHIFT_REFIT_GEOMETRY_MATERIAL_FITTER="${SHIFT_REFIT_GEOMETRY_MATERIAL_FITTER:-0}"
SHIFT_REFIT_GEOMETRY_MATERIAL_SMOOTHER="${SHIFT_REFIT_GEOMETRY_MATERIAL_SMOOTHER:-0}"
SHIFT_REFIT_GEOMETRY_TARGET_MATERIAL="${SHIFT_REFIT_GEOMETRY_TARGET_MATERIAL:-0}"
SHIFT_REFIT_LOG_GEOMETRY_COMPARISON="${SHIFT_REFIT_LOG_GEOMETRY_COMPARISON:-0}"

# Canonical production reconstruction. The detector-ablation scan is closed:
# retain the validated DT augmentation and disable tracker, calorimeter, ZDC,
# GEM, and extended-timing experiments. Change these values deliberately in
# this file if a future study reopens reconstruction development.
SHIFT_DT_MODE="standard"
SHIFT_TRACKER_MODE="none"
SHIFT_ENABLE_GEM="0"
SHIFT_ENABLE_HCAL_DIAGNOSTICS="0"
SHIFT_ENABLE_ZDC_DIAGNOSTICS="0"
SHIFT_AUGMENT_DT_HITS="1"
SHIFT_AUGMENT_TRACKER_HITS="0"
SHIFT_USE_EXTENDED_TIMING="0"

PYTHIA_CONFIG="Configuration/GenProduction/${PROCESS}_pythia8_cff.py"
SAMPLE_DIR="${SAMPLE_DIR:-$SAMPLE_BASE/$SAMPLE_NAME/$CAMPAIGN_NAME}"
TRIGGER_TIMELINE_DIR="${TRIGGER_TIMELINE_DIR:-$SAMPLE_DIR/trigger_timelines}"

# Production storage layout. Override any of these when a site requires a
# different PNFS/dCache (or local filesystem) directory structure.
SAMPLES_DIR="${SAMPLES_DIR:-$SAMPLE_DIR/samples}"
STEP1_DIR="${STEP1_DIR:-$SAMPLES_DIR/step1}"
STEP2_DIR="${STEP2_DIR:-$SAMPLES_DIR/step2}"
STEP3_DIR="${STEP3_DIR:-$SAMPLES_DIR/step3}"
STEP4_DIR="${STEP4_DIR:-$SAMPLES_DIR/step4}"
CONFIG_BASE_DIR="${CONFIG_BASE_DIR:-$SAMPLE_DIR/configs}"
STEP1_CONFIG_DIR="${STEP1_CONFIG_DIR:-$CONFIG_BASE_DIR/step1}"
STEP2_CONFIG_DIR="${STEP2_CONFIG_DIR:-$CONFIG_BASE_DIR/step2}"
STEP3_CONFIG_DIR="${STEP3_CONFIG_DIR:-$CONFIG_BASE_DIR/step3}"
STEP4_CONFIG_DIR="${STEP4_CONFIG_DIR:-$CONFIG_BASE_DIR/step4}"
LOG_DIR="${LOG_DIR:-$SAMPLE_DIR/logs}"
CROSS_SECTION_FILE="${CROSS_SECTION_FILE:-$SAMPLE_DIR/cross_sections.txt}"
