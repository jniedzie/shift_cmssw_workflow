* ---------------------------------------------------------------------------- *
* 'regn' file for BASIC_ELEMENT: 'lhc_MCBXbLQ1'                                *
* ---------------------------------------------------------------------------- *
*                                                                              *
* 
*
* -*- fluka -*-
*
* Element: MCBX beam pipe and screen (1.9K, Q3)
*
*
* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
* @@@
* @@@   FLUKA model of MCBX beam pipe and screen (1.9K, Q1), 14/11/2012 
* @@@   (A. Lechner)
* @@@ 
* @@@   Beam pipe ID/OD: 5.3/6.6 cm
* @@@ 
* @@@   Beam screen dimensions from: LHC Project Document LHC-VSS-ES-0002 
* @@@ 
* @@@   Defines: Use
* @@@             '#define __MCBXBODY_AS_VERTICAL_KICKER__','#define IR1' 
* @@@             '#define __MCBXBODY_AS_HORIZONTAL_KICKER__','#define IR5' 
* @@@            to determine magnetic length according to kick 
* @@@            direction (IR1, IR5)
* @@@
* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*
*
* ### Vacuum inside beam screen ### 
MCBXb1v      5 | -MCBXb1ms +MCBXb1me +MCBXb102 +MCBXb106 -MCBXb107
MCBXb1vf     5 | +MCBXbLQ1 +MCBXb1ms +MCBXb102 +MCBXb106 -MCBXb107
MCBXb1vb     5 | +MCBXbLQ1 -MCBXb1me +MCBXb102 +MCBXb106 -MCBXb107
*
* ### Beam screen ### 
MCBXb1s      5 | -MCBXb1ms +MCBXb1me +MCBXb101 -MCBXb102 +MCBXb105 -MCBXb108 
               | -MCBXb1ms +MCBXb1me +MCBXb101 +MCBXb105 -MCBXb106 
               | -MCBXb1ms +MCBXb1me +MCBXb101 +MCBXb107 -MCBXb108 
MCBXb1sf     5 | +MCBXbLQ1 +MCBXb1ms +MCBXb101 -MCBXb102 +MCBXb105 -MCBXb108 
               | +MCBXbLQ1 +MCBXb1ms +MCBXb101 +MCBXb105 -MCBXb106 
               | +MCBXbLQ1 +MCBXb1ms +MCBXb101 +MCBXb107 -MCBXb108 
MCBXb1sb     5 | +MCBXbLQ1 -MCBXb1me +MCBXb101 -MCBXb102 +MCBXb105 -MCBXb108 
               | +MCBXbLQ1 -MCBXb1me +MCBXb101 +MCBXb105 -MCBXb106 
               | +MCBXbLQ1 -MCBXb1me +MCBXb101 +MCBXb107 -MCBXb108 
*
* ### Beam screen cooling tubes ### 
MCBXb1t      5 | -MCBXb1ms +MCBXb1me +MCBXb111 -MCBXb112
               | -MCBXb1ms +MCBXb1me +MCBXb113 -MCBXb114
MCBXb1tf     5 | +MCBXbLQ1 +MCBXb1ms +MCBXb111 -MCBXb112
               | +MCBXbLQ1 +MCBXb1ms +MCBXb113 -MCBXb114
MCBXb1tb     5 | +MCBXbLQ1 -MCBXb1me +MCBXb111 -MCBXb112
               | +MCBXbLQ1 -MCBXb1me +MCBXb113 -MCBXb114
*
* ### Beam screen He cooling ### 
MCBXb1h      5 | -MCBXb1ms +MCBXb1me +MCBXb112
               | -MCBXb1ms +MCBXb1me +MCBXb114
MCBXb1hf     5 | +MCBXbLQ1 +MCBXb1ms +MCBXb112
               | +MCBXbLQ1 +MCBXb1ms +MCBXb114
MCBXb1hb     5 | +MCBXbLQ1 -MCBXb1me +MCBXb112
               | +MCBXbLQ1 -MCBXb1me +MCBXb114
*
* ### Vacuum between beam screen and beam pipe ### 
MCBXb1c      5 | -MCBXb1ms +MCBXb116 +MCBXb1me -MCBXb101 
               | -MCBXb1ms +MCBXb116 +MCBXb1me -MCBXb105 -MCBXb111
               | -MCBXb1ms +MCBXb116 +MCBXb1me +MCBXb108 -MCBXb113
MCBXb1cf     5 | +MCBXbLQ1 +MCBXb1ms +MCBXb116 -MCBXb101 
               | +MCBXbLQ1 +MCBXb1ms +MCBXb116 -MCBXb105 -MCBXb111
               | +MCBXbLQ1 +MCBXb1ms +MCBXb116 +MCBXb108 -MCBXb113
MCBXb1cb     5 | +MCBXbLQ1 -MCBXb1me +MCBXb116 -MCBXb101 
               | +MCBXbLQ1 -MCBXb1me +MCBXb116 -MCBXb105 -MCBXb111
               | +MCBXbLQ1 -MCBXb1me +MCBXb116 +MCBXb108 -MCBXb113
*
* ### Beam pipe ### 
MCBXb1p      5 | +MCBXbLQ1 -MCBXb1ms +MCBXb1me -MCBXb116
MCBXb1pf     5 | +MCBXbLQ1 +MCBXb1ms -MCBXb116 
MCBXb1pb     5 | +MCBXbLQ1 -MCBXb1me -MCBXb116 
*
* 
* 
* 
*                                                                              *
* ---------------------------------------------------------------------------- *
* 'regn' file for BASIC_ELEMENT: 'lhc_MQXABODY'                                *
* ---------------------------------------------------------------------------- *
*                                                                              *
* 
*
* -*- fluka -*-
*
* Element: MQXA 
*
*
* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
* @@@
* @@@   FLUKA model of MQXA magnet, A. Lechner, 23/06/2011 
* @@@   based on existing model by C. Hoa
* @@@ 
* @@@   Model origin coincides with mechanical center of MQXA magnet
* @@@ 
* @@@   Refs: 
* @@@     [1] Ajima et al.,
* @@@         The MQXA quadrupoles for the LHC low-beta insertions, 
* @@@         Nucl. Instr. and Meth., Vol 550, Pages 499-513, 2005.
* @@@         DOI: 10.1016/j.nima.2005.04.092.
* @@@     [2] Yamamoto et al.,
* @@@         Design Study of a Superconducting Insertion Quadrupole
* @@@         Magnet for the Large Hadron Collider,
* @@@         IEEE Trans. Appl. Supercond., Vol 7, Pages 747-750, 1997.
* @@@     [3] Tsuchiya et al.,
* @@@         Magnetic Design of a Low-beta Quadrupole Magnet for the
* @@@         LHC Interaction Region,
* @@@         IEEE Trans. Appl. Supercond., Vol 7, Pages 135-138, 2000.
* @@@     
* @@@   Defines: * Use '#define IR5' to rotate beam screen according to  
* @@@              IR5 specs 
* @@@            * Use '#define __TRIPLET_YOKE_BLCKHOLE__' to set
* @@@              yoke to blackhole
* @@@     
* @@@   Hack: Mechanical length reduced by 2 cm to avoid overlagp
* @@@         with adjacent magnet 
* @@@         Better solution for future: correctly implement cold 
* @@@         length 
* @@@
* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
* 
*
* ### Vacuum inside beam screen ###
QXABSI       5 | -MQXAPF +MQXAPB +MQXAbsir +MQXAxzri -MQXAxzli
*
QXABSIf      5 | +MQXABODY +MQXAPF +MQXAbsir +MQXAxzri -MQXAxzli
*
QXABSIb      5 | +MQXABODY -MQXAPB +MQXAbsir +MQXAxzri -MQXAxzli
*
* ### Vacuum between beam screen and pipe ###
QXAVAC       5 | -MQXAPF +MQXAPB +MQXAbsor +MQXAxzle -MQXAlclo
               | -MQXAPF +MQXAPB +MQXAbsor -MQXAxzre -MQXArclo
               | -MQXAPF +MQXAPB +MQXAai -MQXAbsor 
*
QXAVACf      5 | +MQXABODY +MQXAPF +MQXAbsor +MQXAxzle -MQXAlclo
               | +MQXABODY +MQXAPF +MQXAbsor -MQXAxzre -MQXArclo
               | +MQXABODY +MQXAPF +MQXAai -MQXAbsor 
*
QXAVACb      5 | +MQXABODY -MQXAPB +MQXAbsor +MQXAxzle -MQXAlclo
               | +MQXABODY -MQXAPB +MQXAbsor -MQXAxzre -MQXArclo
               | +MQXABODY -MQXAPB +MQXAai -MQXAbsor 
*
* ### Helium vessel shell ###
QXASHLL      5 | +MQXABODY -MQXAPF +MQXAPB -MQXAshli
*
QXASHLLf     5 | +MQXABODY +MQXAPF -MQXAshli
*
QXASHLLb     5 | +MQXABODY -MQXAPB -MQXAshli
*
* ### Yoke ###
QXAYOKE      5 | -MQXAPF +MQXAPB +MQXAshli -MQXAcole 
                 +MQXAykp5 -MQXAykp8 +MQXAykp1 -MQXAykp4
* (exluding helium passage)
                 -MQXAykh1 -MQXAykh2 -MQXAykh3 -MQXAykh4  
* (exluding fixing pins)
                 -MQXAykf1 -MQXAykf2 -MQXAykf3 -MQXAykf4 
                 -MQXAykf5 -MQXAykf6 -MQXAykf7 -MQXAykf8 
               | -MQXAPF +MQXAPB +MQXAshli +MQXAykp6 -MQXAykp7 -MQXAykp1   
               | -MQXAPF +MQXAPB +MQXAshli +MQXAykp6 -MQXAykp7 +MQXAykp4 
               | -MQXAPF +MQXAPB +MQXAshli +MQXAykp2 -MQXAykp3 +MQXAykp8 -MQXAykk2
               | -MQXAPF +MQXAPB +MQXAshli +MQXAykp2 -MQXAykp3 -MQXAykp5 +MQXAykk1
* (between keys)
               | -MQXAPF +MQXAPB +MQXAshli +MQXAykk2 -MQXAykk3
               | -MQXAPF +MQXAPB +MQXAshli +MQXAykk2 +MQXAykk4 -MQXAykk5
               | -MQXAPF +MQXAPB +MQXAshli +MQXAykk2 +MQXAykk6 -MQXAykk7
               | -MQXAPF +MQXAPB +MQXAshli +MQXAykk2 +MQXAykk8
               | -MQXAPF +MQXAPB +MQXAshli -MQXAykk1 -MQXAykk3
               | -MQXAPF +MQXAPB +MQXAshli -MQXAykk1 +MQXAykk4 -MQXAykk5
               | -MQXAPF +MQXAPB +MQXAshli -MQXAykk1 +MQXAykk6 -MQXAykk7
               | -MQXAPF +MQXAPB +MQXAshli -MQXAykk1 +MQXAykk8
*
QXAYOKEf     5 | +MQXABODY +MQXAPF +MQXAshli -MQXAcole 
                 +MQXAykp5 -MQXAykp8 +MQXAykp1 -MQXAykp4
* (exluding helium passage)
                 -MQXAykh1 -MQXAykh2 -MQXAykh3 -MQXAykh4  
* (exluding fixing pins)
                 -MQXAykf1 -MQXAykf2 -MQXAykf3 -MQXAykf4 
                 -MQXAykf5 -MQXAykf6 -MQXAykf7 -MQXAykf8 
               | +MQXABODY +MQXAPF +MQXAshli +MQXAykp6 -MQXAykp7 -MQXAykp1   
