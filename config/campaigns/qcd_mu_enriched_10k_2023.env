# Source with `set -a` before run_condor.sh. Step-1-only 10k-attempt mu-enriched QCD.
# The provisional ATLAS proxy makes this a machinery sample, not final physics.
SAMPLE_NAME=qcd
PROCESS=QCD_MuEnriched_FixedTarget_pThat_1to5GeV_13p6TeV
CAMPAIGN_NAME=${CAMPAIGN_NAME:-QCD_MuEnriched_FixedTarget_pThat_1to5GeV_ATLASproxy_10k_2023_v1}
N_EVENTS=${N_EVENTS:-10}
N_JOBS=${N_JOBS:-1000}
GENERATOR_SEED=713579
SIMULATION_SEED=724680
COLLISION_YEAR=2023
PILEUP_MODE=none
TRIGGER_SCENARIO=none
TRIGGER_TIMELINE_MODE=none
SHIFT_TIMING_MODE=nominal
SHIFT_TIMING_BX_OFFSET=0
SHIFT_TIMING_PHASE_NS=0.0
CONDOR_REQUEST_MEMORY_MB=4000
CONDOR_JOB_FLAVOUR=workday
# Same reviewed repaired proxy as the earlier QCD machinery campaign, never CMS/IR5.
SHIFT_LSS_MATERIAL_MODE=external
SHIFT_LSS_FIELD_MODE=ir1_atlas_proxy
