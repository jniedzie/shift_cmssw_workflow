D2BPL_XX     5 +MBRCBODY -d2pzd -d2_xli +d2_cli
D2BPR_XX     5 +MBRCBODY -d2pzd -d2_xri +d2_cri
D2BPL_HE     5 +MBRCBODY -d2pzd -d2_il +d2_xli
D2BPR_HE     5 +MBRCBODY -d2pzd -d2_ir +d2_xri
D2BPL_O      5 +MBRCBODY -d2pzd -d2_plo +d2_il
D2BPR_O      5 +MBRCBODY -d2pzd -d2_pro +d2_ir
