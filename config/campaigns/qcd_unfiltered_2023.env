# Source with set -a in a fresh shell. This prepares, but never submits, a bin.
# pThat binning is the phase-space definition, not an event-acceptance filter.
QCD_BIN=${QCD_BIN:-1to2}
case "$QCD_BIN" in
  1to2) GEN_PTHAT_MIN=1; GEN_PTHAT_MAX=2; seed_offset=0 ;;
  2to5) GEN_PTHAT_MIN=2; GEN_PTHAT_MAX=5; seed_offset=100000 ;;
  5to10) GEN_PTHAT_MIN=5; GEN_PTHAT_MAX=10; seed_offset=200000 ;;
  10to20) GEN_PTHAT_MIN=10; GEN_PTHAT_MAX=20; seed_offset=300000 ;;
  20to-1) GEN_PTHAT_MIN=20; GEN_PTHAT_MAX=-1; seed_offset=400000 ;;
  *) echo "Unsupported QCD_BIN: $QCD_BIN (0--1 is not validated)" >&2; return 2 ;;
esac
SAMPLE_NAME=qcd
PROCESS=QCD_UnfilteredDecays_FixedTarget_pThat_1to5GeV_13p6TeV
CAMPAIGN_NAME=${CAMPAIGN_NAME:-QCD_UnfilteredDecays_pThat_${QCD_BIN}_ATLASproxy_2023_v1}
N_EVENTS=${N_EVENTS:-250}
# No large campaign size is silently selected; specify N_JOBS for production.
N_JOBS=${N_JOBS:-1}
GENERATOR_SEED=${GENERATOR_SEED:-$((21000000+seed_offset))}
SIMULATION_SEED=${SIMULATION_SEED:-$((31000000+seed_offset))}
unset seed_offset
WORKFLOW_LOCAL_GENERATOR=1
CMSSW_PREPARED=1
CLEANUP_PREVIOUS_STEP=${CLEANUP_PREVIOUS_STEP:-1}
CONDOR_REQUEST_CPUS=1
CONDOR_REQUEST_MEMORY_MB=4000
CONDOR_REQUEST_DISK_MB=10000
CONDOR_MAX_RUNTIME_SECONDS=50400
CONDOR_JOB_FLAVOUR=""
COLLISION_YEAR=2023
PILEUP_MODE=none
TRIGGER_SCENARIO=none
TRIGGER_TIMELINE_MODE=none
PIGGYBACK_FILTER_RECONSTRUCTION=0
ENABLE_EXONANOAOD=0
STEP4_INPUTS_PER_JOB=1
SHIFT_TIMING_MODE=nominal
SHIFT_TIMING_BX_OFFSET=0
SHIFT_TIMING_PHASE_NS=0.0
# Same reviewed proxy as the preceding campaigns, not CMS/IR5.
SHIFT_LSS_MATERIAL_MODE=external
SHIFT_LSS_FIELD_MODE=ir1_atlas_proxy
SHIFT_LSS_GDML_FILE=PhysicsTools/ShiftLssGeometry/data/ir1_atlas_proxy/lhc_ir1_halfspace_repaired_20260910.gdml
SHIFT_LSS_GDML_SHA256=d6f9f6fa5658a55e365d5a80025522cac7bcab1ce6fb006ca27b5120f5f41f66
SHIFT_LSS_ARTIFACT_ORIGIN_IN_MODEL_CM=0.0,4299.5,14575.200000105498
SHIFT_LSS_MODEL_ORIGIN_CM=0,0,0
SHIFT_LSS_MODEL_TO_CMS=1,0,0,0,1,0,0,0,1
SHIFT_LSS_MINIMUM_ABS_Z_CM=1100
SHIFT_LSS_MATERIAL_BOUNDARY_ABS_Z_CM=14800
SHIFT_LSS_GEANT4E_MAXIMUM_STEP_LENGTH_MM=0.2
SHIFT_LSS_GEANT4E_MAXIMUM_PATH_LENGTH_CM=20000
SHIFT_LSS_FIELD_SCALE=1.0
SHIFT_USE_VERTEX_CONSTRAINED_REFIT=1
SHIFT_USE_MATERIAL_AWARE_VERTEX_TRANSPORT=0
SHIFT_USE_FORWARD_COMMON_VERTEX_FIT=0
SHIFT_DT_MODE=standard
SHIFT_TRACKER_MODE=none
SHIFT_ENABLE_GEM=0
SHIFT_ENABLE_HCAL_DIAGNOSTICS=0
SHIFT_ENABLE_ZDC_DIAGNOSTICS=0
SHIFT_AUGMENT_DT_HITS=1
SHIFT_AUGMENT_TRACKER_HITS=0
SHIFT_USE_EXTENDED_TIMING=0
