* 
*
* -*- fluka -*-
*
* Element: MCSOX
*
*
* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
* @@@
* @@@   FLUKA model of MCSOX multipole correctors (next to Q3), 10/03/2012 
* @@@   (implemented by A. Lechner)
* @@@   
* @@@   Drawings: LHCMCSOX0001
* @@@             Note: Fermilab drawings can be found on
* @@@             http://tomato.fnal.gov/lhcirq/drawings/index.html
* @@@ 
* @@@   Mechanical length: 21.15 cm
* @@@   Magnetic length MCOSX/MCOX/MCSSX: 13.8/13.7/13.2 cm (first taken)
* @@@   Mechanical/Magnetic middle offset: ??? cm 
* @@@ 
* @@@   Model origin coincides with optical center of MCOSX/MCOX/MCSSX
* @@@     
* @@@   Open issues: 
* @@@            *) Calculate actual coil composition (now approximated
* @@@               with Cu)
* @@@            *) Determine actual composition of insulator betw. coils
* @@@            *) Include vacuum vessel
* @@@     
* @@@   Defines: *) #define __MCSOX_FIELD_ON__
* @@@               Turn on magnetic field
* @@@            *) #define IR5 
* @@@               Rotate beam screen according to IR5 specs  
* @@@     
* @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*
*
* ### Vacuum ###
ASSIGNMA      VACUUM  MCSOXVAC
*
*
* ### Cold mass shell ###
* Material: ???
ASSIGNMA     cSS304L  MCSOXCMS 
*
*
* ### Helium in cold mass shell ###
ASSIGNMA    LHe_1.9K  MCSOXCMH 
*
*
* ### Outer shell and support flange ###
ASSIGNMA     cSS304L  MCSOXSFL
ASSIGNMA     cSS304L  MCSOXSHL
*
*
* ### Yoke lamination ###
* Material: Low carbon steel (LHCMQSXA0030)
#if __MCSOX_FIELD_ON__
ASSIGNMA    cLowCSTL   MCSOXYK                           1.0       
#else
ASSIGNMA    cLowCSTL   MCSOXYK 
#endif
ASSIGNMA    cLowCSTL  MCSOXYKF 
ASSIGNMA    cLowCSTL  MCSOXYKB
*
*
* ### Insulation ###
* Material: ???
#if __MCSOX_FIELD_ON__
ASSIGNMA         G11   MCSOXI1                           1.0 
#else
ASSIGNMA         G11   MCSOXI1
#endif
ASSIGNMA         G11  MCSOXI1F
ASSIGNMA         G11  MCSOXI1B
*
* Material: ???
#if __MCSOX_FIELD_ON__
ASSIGNMA         G11   MCSOXI2                           1.0 
#else
ASSIGNMA         G11   MCSOXI2
#endif
ASSIGNMA         G11  MCSOXI2F
ASSIGNMA         G11  MCSOXI2B
*
* Material: ???
#if __MCSOX_FIELD_ON__
ASSIGNMA         G11   MCSOXI3                           1.0 
#else
ASSIGNMA         G11   MCSOXI3
#endif
ASSIGNMA         G11  MCSOXI3F
ASSIGNMA         G11  MCSOXI3B
*
* Material: G11 (LHCMQSXA0040)
#if __MCSOX_FIELD_ON__
ASSIGNMA         G11   MCSOXI4                           1.0 
#else
ASSIGNMA         G11   MCSOXI4
#endif
ASSIGNMA         G11  MCSOXI4F
ASSIGNMA         G11  MCSOXI4B
*
*
* ### MCSSX coils and spacers ###
* Material: approximated by Cu (real composition to be calculated)
#if __MCSOX_FIELD_ON__
ASSIGNMA     NbTi.w2   MCSOXC1                           1.0 
#else
ASSIGNMA     NbTi.w2   MCSOXC1
#endif
ASSIGNMA     NbTi.w2  MCSOXC1F
ASSIGNMA     NbTi.w2  MCSOXC1B
*
* Material: G11 (LHCMQSXA0027)
#if __MCSOX_FIELD_ON__
ASSIGNMA         G11   MCSOXS1                           1.0 
#else
ASSIGNMA         G11   MCSOXS1
#endif
ASSIGNMA         G11  MCSOXS1F
ASSIGNMA         G11  MCSOXS1B
*
*
* ### MCOX coils and spacers ###
* Material: approximated by Cu (real composition to be calculated)
#if __MCSOX_FIELD_ON__
ASSIGNMA     NbTi.w2   MCSOXC2                           1.0 
#else
ASSIGNMA     NbTi.w2   MCSOXC2
#endif
ASSIGNMA     NbTi.w2  MCSOXC2F
ASSIGNMA     NbTi.w2  MCSOXC2B
*
* Material: G11 (LHCMQSXA0025)
#if __MCSOX_FIELD_ON__
ASSIGNMA         G11   MCSOXS2                           1.0 
#else
ASSIGNMA         G11   MCSOXS2
#endif
ASSIGNMA         G11  MCSOXS2F
ASSIGNMA         G11  MCSOXS2B
*
*
* ### MCOSX coils and spacers ###
* Material: approximated by Cu (real composition to be calculated)
#if __MCSOX_FIELD_ON__
ASSIGNMA     NbTi.w2   MCSOXC3                           1.0 
#else
ASSIGNMA     NbTi.w2   MCSOXC3
#endif
ASSIGNMA     NbTi.w2  MCSOXC3F
ASSIGNMA     NbTi.w2  MCSOXC3B
*
* Material: G11 (LHCMQSXA0023)
#if __MCSOX_FIELD_ON__
ASSIGNMA         G11   MCSOXS3                           1.0 
#else
ASSIGNMA         G11   MCSOXS3
#endif
ASSIGNMA         G11  MCSOXS3F
ASSIGNMA         G11  MCSOXS3B
*
*
* ### MCSSX connections support plate ###
* Material: G11 (LHCMQSXA0028)
ASSIGNMA         G11  MCSOXSP1
*
*
* ### MCOX connections support plate ###
* Material: G11 (LHCMQSXA0026)
ASSIGNMA         G11  MCSOXSP2
*
*
* ### MCOSX connections support plate ###
* Material: G11 (LHCMQSXA0024)
ASSIGNMA         G11  MCSOXSP3
*
*
* ### Cover plate ###
* Material: G11 (LHCMQSXA0032)
ASSIGNMA         G11  MCSOXCVP
*
*
* ### Clamping plates ###
* Material: G11 (LHCMQSXA0033)
ASSIGNMA         G11  MCSOXCP1
ASSIGNMA         G11  MCSOXCP2
ASSIGNMA         G11  MCSOXCP3
*
*
* ### End support plate ###
* Material: ???
ASSIGNMA         G11  MCSOXESP
*
*
* ### Terminal box ###
* Material: ???
ASSIGNMA         G11  MCSOXTMB
*
*
* ### He around cold bore ###
#if __MCSOX_FIELD_ON__
ASSIGNMA    LHe_1.9K   MCSOXCH                           1.0       
#else
ASSIGNMA    LHe_1.9K   MCSOXCH 
#endif
ASSIGNMA    LHe_1.9K  MCSOXCHF 
ASSIGNMA    LHe_1.9K  MCSOXCHB
*
*
* ### Cold bore ###
* Material: 
#if __MCSOX_FIELD_ON__
ASSIGNMA     cSS304L   MCSOXCB                           1.0       
#else
ASSIGNMA     cSS304L   MCSOXCB 
#endif
ASSIGNMA     cSS304L  MCSOXCBF 
ASSIGNMA     cSS304L  MCSOXCBB
*
*
* ### He pipes for beam screen cooling ###
