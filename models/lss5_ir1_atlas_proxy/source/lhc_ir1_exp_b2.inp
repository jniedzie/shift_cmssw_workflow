D2FPL_XX     5 +MBRCBODY +d2pzu -d2_xli +d2_cli
D2FPR_XX     5 +MBRCBODY +d2pzu -d2_xri +d2_cri
D2FPL_HE     5 +MBRCBODY +d2pzu -d2_il +d2_xli
D2FPR_HE     5 +MBRCBODY +d2pzu -d2_ir +d2_xri
D2FPL_O      5 +MBRCBODY +d2pzu -d2_plo +d2_il
D2FPR_O      5 +MBRCBODY +d2pzu -d2_pro +d2_ir
D2FPL        5 +MBRCBODY +d2pzu -d2_pli +d2_plo
D2FPR        5 +MBRCBODY +d2pzu -d2_pri +d2_pro
D2FPL_I      5 +MBRCBODY +d2_pli +d2pzu -d2BS_lo
               | +MBRCBODY +d2BS_lo +d2pzu -d2pBSaw
               | +MBRCBODY +d2BS_lo +d2pBSbw +d2pzu
D2FPR_I      5 +MBRCBODY +d2_pri +d2pzu -d2BS_ro
