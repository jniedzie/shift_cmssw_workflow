export SHIFT_RECO_VARIANT=dt_hcal_tracker_seeded_v1
export SHIFT_RECO_VARIANT_CODE=18

export SHIFT_STEP2_VARIANT=
export SHIFT_ZDC_DIGI_TIME_PHASE_OFFSET_NS=0.0

# Standard SHIFT muon reconstruction plus the validated DT augmentation.
export SHIFT_DT_MODE=standard
export SHIFT_ENABLE_GEM=0
export SHIFT_AUGMENT_DT_HITS=1
export SHIFT_AUGMENT_TRACKER_HITS=1

# Run the forward P5 tracker seed/CKF prototype. Tracker-only fits are not
# promoted to ShiftMuons: they must form a successful global match with an
# independently reconstructed DSA/cosmic/traversing muon-system track.
export SHIFT_TRACKER_MODE=p5

# Detector-aware exact crossed-cell HBHE/HO diagnostics. Calorimeter data are
# a positive tag and timing cross-check, never a Kalman position measurement.
export SHIFT_ENABLE_HCAL_DIAGNOSTICS=1
export SHIFT_ENABLE_ZDC_DIAGNOSTICS=0
export SHIFT_USE_EXTENDED_TIMING=1
